node_modules/
dist/
.env*.local

# Generated by `npm run build:data` and published to the gh-pages branch by `npm run deploy`.
# Kept out of main so rebuilding large tile files never bloats the repository history.
public/data/

# Raw official source data stays local (large, licence often unconfirmed).
# Each region keeps only its source.json and boundary.geojson in git.
data/regions/*/*/*
!data/regions/*/*/source.json
!data/regions/*/*/boundary.geojson
!data/regions/*/*/README.md

# Test output (screenshots, downloads)
tests/out/
