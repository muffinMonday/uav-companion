node_modules/
dist/
.env*.local

# Generated by `npm run build:data` and published to the gh-pages branch by `npm run deploy`.
# Kept out of main so rebuilding large tile files never bloats the repository history.
public/data/

# Raw official source data stays local (large, licence often unconfirmed).
# Each region keeps only its source.json and boundary.geojson in git.
data/regions/*/*/*
!data/regions/*/*/source.json
!data/regions/*/*/boundary.geojson
!data/regions/*/*/README.md
!data/regions/cn/yunnan/zones.geojson
# Malaysia ENR 5.1: the converted layers and the exception report are the reviewable source of the archive
!data/regions/my/my-enr51/layers/
!data/regions/my/my-enr51/layers/*.geojson
!data/regions/my/my-enr51/exceptions.json
!data/regions/my/my-enr51/references.json
!data/regions/my/my-enr51/approx-provenance.json
!data/regions/my/my-enr51/approx-sources/
!data/regions/my/my-enr51/approx-sources/osm-extract.json
# Vietnam ENR 5.1: layers, exception report and the exact official page the layers were built from
!data/regions/vn/vn-enr51/layers/
!data/regions/vn/vn-enr51/layers/*.geojson
!data/regions/vn/vn-enr51/exceptions.json
!data/regions/vn/vn-enr51/source/
!data/regions/vn/vn-enr51/source/VV-ENR-5.1-en-GB.html

# Test output (screenshots, downloads)
tests/out/

# Planning material (screenshots of third-party maps and the like): never committed
planning/

# Regions marked "publish": false are built here and never deployed (see scripts/strip-local.js)
public/data-local/

# Supabase: the link to a project and any local secrets stay on this machine
supabase/.temp/
supabase/.branches/
supabase/.env
.env*
