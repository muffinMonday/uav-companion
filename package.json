{
  "name": "uav-companion",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Open-source map of suitable-flight (适飞) drone zones, starting with China",
  "scripts": {
    "deploy": "vite build && node scripts/strip-local.js && gh-pages -d dist --nojekyll --no-history",
    "verify:data": "node scripts/verify-data.js",
    "dev": "vite",
    "build:data": "node scripts/build-data.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run.mjs",
    "test:unit": "node tests/run.mjs --unit"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0"
  },
  "devDependencies": {
    "geojson-vt": "^5.0.4",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.65.0",
    "shapefile": "^0.6.6",
    "vite": "^8.3.7",
    "vt-pbf": "^3.1.3"
  }
}
